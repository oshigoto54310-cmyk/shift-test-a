  "        ctx.fillStyle = ctx.strokeStyle = accent ? C.accent : C.",
  "        ctx.globalAlpha = (accent ? 0.95 : 0.82) * fade;",
  "        const dx = p[0] - q[0];",
  "        const dy = p[1] - q[1];",
  "        if (dx * dx + dy * dy > 4) {",
  "          ctx.lineWidth = 2.2;",
  "          ctx.beginPath();",
  "          ctx.moveTo(q[0], q[1]);",
  "          ctx.lineTo(p[0], p[1]);",
  "          ctx.stroke();",
  "        } else {",
  "          ctx.fillRect(p[0] - 1.4, p[1] - 1.4, 2.8, 2.8);",
  "        }",
  "      }",
  "    },",
  "    [frame, pts],",
  "  );",
  "  const t = frame - BREAK;",
  "  return (",
  "    <AbsoluteFill style={{ backgroundColor: C.bg }}>",
