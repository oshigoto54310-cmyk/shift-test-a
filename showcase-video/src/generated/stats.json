  "        const a = (1 - e) * (1 - e);",
  "        const b = 2 * e * (1 - e);",
  "        const c = e * e;",
  "        let x = a * start[i * 2] + b * ctrl[i * 2] + c * target[",
  "        let y = a * start[i * 2 + 1] + b * ctrl[i * 2 + 1] + c *",
  "        // 組み上がったあとの呼吸: 拍ごとに少しふくらむ",
  "        const beat = (t % 15) / 15;",
  "        const barHit = Math.floor(t / 15) % 4 === 0;",
  "        const puff = (barHit ? 9 : 3.5) * Math.exp(-beat * 5) * ",
  "        x += Math.cos(phase[i]) * puff + Math.sin(f * 0.05 + pha",
  "        y += Math.sin(phase[i]) * puff + Math.cos(f * 0.043 + ph",
  "        // 一部の粒は定着させず、文字のまわりを漂わせる",
  "        if (i % 14 === 0) {",
  "          x += Math.sin(f * 0.031 + phase[i] * 3) * 46 * c;",
  "          y += Math.cos(f * 0.027 + phase[i] * 2) * 38 * c;",
  "        }",
  "        // 退場",
  "        if (f > EXIT) {",
  "          const q = easeOut(clamp01((f - EXIT) / 30), 2.4);",
  "          x += out[i * 2] * q;",
  "          y += out[i * 2 + 1] * q;",
  "        }",
  "        o[0] = x;",
  "        o[1] = y;",
  "      };",
  "      const fade = 1 - clamp01((frame - EXIT) / 24);",
  "      // 組み上がったら、粒の下に文字そのものを薄く敷いて読みやすくする",
  "      const solid = clamp01((frame - BREAK - 44) / 20) * (1 - cl",
  "      if (solid > 0) {",
  "        ctx.font = BIG_FONT;",
  "        (ctx as unknown as { letterSpacing: string }).letterSpac",
  "        ctx.textAlign = \"center\";",
  "        ctx.textBaseline = \"middle\";",
  "        ctx.fillStyle = C.ink;",
  "        ctx.globalAlpha = solid * 0.5;",
  "        for (const l of BIG_LINES) ctx.fillText(l.text, W / 2, l",
  "        (ctx as unknown as { letterSpacing: string }).letterSpac",
  "      }",
  "      ctx.globalCompositeOperation = \"lighter\";",
  "      ctx.lineCap = \"round\";",
  "      const p = [0, 0];",
