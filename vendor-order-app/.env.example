# ====================================================================
# 環境変数サンプル
# このファイルをコピーして .env を作り、値を書き換えてください。
#   cp .env.example .env
#
# 重要: .env は Git 管理対象外です（.gitignore 済み）。
#       秘密鍵・パスワードを絶対にコミットしないでください。
# ====================================================================

# --- 基本 ---
APP_NAME=ベンダー別発注管理
ENVIRONMENT=development          # development / production
DEBUG=false

# --- データベース ---
# 開発（SQLite）
DATABASE_URL=sqlite:///./order_app.db
# 本番（PostgreSQL）。docker-compose を使う場合は下記をそのまま利用できます。
# DATABASE_URL=postgresql+psycopg://order_user:CHANGE_ME@db:5432/order_app

# --- 認証 ---
# 必ず推測不可能な値に変更してください。
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_必ず本番では推測不可能な値に変更すること
JWT_ALGORITHM=HS256
SESSION_MINUTES=480              # セッション有効期限（分）
MAX_LOGIN_FAILURES=5             # 何回失敗したらロックするか
LOCK_MINUTES=15                  # ロック時間（分）

# --- Cookie / HTTPS ---
# 本番（HTTPS）では必ず COOKIE_SECURE=true にしてください。
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS ---
# フロントエンドを別ホストで動かす場合のみ設定（カンマ区切り）。
# 同一オリジン配信なら空のままで構いません。
CORS_ORIGINS=

# --- 締め時間のシステム標準値 ---
DEFAULT_ROUGH_DAYS_BEFORE=3      # 概算締め: 納品日の何日前
DEFAULT_FINAL_DAYS_BEFORE=1      # 最終締め: 納品日の何日前
DEFAULT_FINAL_TIME=12:00         # 最終締め時刻（日本時間）
DEFAULT_REPLY_DAYS_BEFORE=1      # ベンダー回答期限: 納品日の何日前
DEFAULT_REPLY_TIME=15:00         # ベンダー回答期限時刻（日本時間）

# --- 入力チェック ---
ABNORMAL_QTY_THRESHOLD=1000      # この数量以上で「異常数量」警告を出す

# --- メール通知 ---
# MAIL_ENABLED=false の場合、通知はDBに記録されますがメール送信はスキップされます。
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid
SMTP_TLS=true

# --- PostgreSQL（docker-compose 用） ---
POSTGRES_DB=order_app
POSTGRES_USER=order_user
POSTGRES_PASSWORD=CHANGE_ME_データベースのパスワード
